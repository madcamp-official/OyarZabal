[Unit]
Description=Generate the daily Pitch Test from yesterday's MLB games
After=network-online.target oyarzabal-benchmark.service
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=5min
User=oyarzabal
Group=oyarzabal
WorkingDirectory=/opt/oyarzabal
EnvironmentFile=/opt/oyarzabal/.env
Environment=DAILY_CHALLENGE_OFFSET_DAYS=1
ExecStart=/opt/oyarzabal/.venv/bin/oyarzabal-generate-daily
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/oyarzabal
